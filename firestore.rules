rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    // User collection
    match /users/{userId} {
      allow read, write: if isValidId(userId);
    }

    // Attendance records
    match /attendance/{attendanceId} {
      allow read, write: if isValidId(attendanceId);
    }

    // Work Sessions
    match /workSessions/{sessionId} {
      allow read, write: if isValidId(sessionId);
    }

    // Breaks
    match /breaks/{breakId} {
      allow read, write: if isValidId(breakId);
    }

    // Work Logs
    match /workLogs/{workLogId} {
      allow read, write: if isValidId(workLogId);
    }

    // Work Log Resources
    match /workLogResources/{resourceId} {
      allow read, write: if isValidId(resourceId);
    }

    // Work Schedules
    match /workSchedules/{scheduleId} {
      allow read, write: if isValidId(scheduleId);
    }

    // Correction Requests
    match /correctionRequests/{requestId} {
      allow read, write: if isValidId(requestId);
    }

    // Audit Logs
    match /auditLogs/{auditId} {
      allow read, write: if isValidId(auditId);
    }
  }
}
