
import express from 'express';
import cors from 'cors';
import { randomBytes } from 'node:crypto';
import { adminAuth, adminDb } from './firebaseAdmin';
import { verifyAdmin } from './middleware/verifyAdmin';

const app = express();
const PORT = Number(process.env.API_PORT || 4000);

app.use(
    cors({
        origin: process.env.CLIENT_ORIGIN || 'http://localhost:3000',
    })
);

app.use(express.json({ limit: '1mb' }));

// Health check
app.get('/api/health', (_req, res) => {
    res.json({ status: 'ok' });
});


app.post('/api/admin/repair-auth-account', verifyAdmin, async (req, res) => {
    try {
        const { uid, email, password } = req.body ?? {};

        if (
            uid !== 'user_admin' ||
            email !== 'admin@teara.internal' ||
            typeof password !== 'string' ||
            password.length < 8
        ) {
            res.status(400).json({ error: 'Invalid account details.' });
            return;
        }

        const profileRef = adminDb.collection('users').doc(uid);
        const profileSnapshot = await profileRef.get();

        if (!profileSnapshot.exists) {
            res.status(404).json({ error: 'Existing Firestore profile not found.' });
            return;
        }

        const profile = profileSnapshot.data();

        if (
            profile?.role !== 'admin' ||
            profile?.email?.toLowerCase() !== email
        ) {
            res.status(403).json({ error: 'Existing administrator profile does not match.' });
            return;
        }

        const existingAuthUser = await adminAuth.getUser(uid).catch((error) => {
            if (error.code === 'auth/user-not-found') return null;
            throw error;
        });

        if (existingAuthUser) {
            res.status(409).json({ error: 'Authentication account already exists for this UID.' });
            return;
        }

        const emailOwner = await adminAuth.getUserByEmail(email).catch((error) => {
            if (error.code === 'auth/user-not-found') return null;
            throw error;
        });

        if (emailOwner) {
            res.status(409).json({
                error: 'This email already belongs to another Authentication UID. Manual reconciliation is required.',
            });
            return;
        }

        await adminAuth.createUser({
            uid,
            email,
            password,
            displayName: profile.name || 'Admin',
            disabled: profile.accountStatus !== 'active',
        });

        res.status(201).json({
            message: 'Administrator Authentication account created.',
            uid,
            email,
        });
    } catch (error) {
        console.error('Administrator account repair failed:', error);
        res.status(500).json({ error: 'Unable to create administrator Authentication account.' });
    }
});


// Resolve a username to an email for Firebase Authentication.
// Returns only the email, never the employee profile.
app.post('/api/auth/resolve-username', async (req, res) => {
    try {
        const username = req.body?.username;

        if (
            typeof username !== 'string' ||
            !/^[a-zA-Z0-9._-]{3,30}$/.test(username)
        ) {
            res.status(401).json({ error: 'Invalid credentials.' });
            return;
        }

        const normalizedUsername = username.trim().toLowerCase();

        const snapshot = await adminDb
            .collection('users')
            .where('username', '==', normalizedUsername)
            .limit(1)
            .get();

        if (snapshot.empty) {
            res.status(401).json({ error: 'Invalid credentials.' });
            return;
        }

        const profile = snapshot.docs[0].data();

        if (
            typeof profile.email !== 'string' ||
            profile.accountStatus !== 'active'
        ) {
            res.status(401).json({ error: 'Invalid credentials.' });
            return;
        }

        res.json({ email: profile.email });
    } catch (error) {
        console.error('Username resolution failed:', error);
        res.status(500).json({ error: 'Unable to process sign-in.' });
    }
});

// Admin-only diagnostics: inspect profile metadata without exposing passwords.
app.get('/api/admin/diagnostics/users', verifyAdmin, async (_req, res) => {
    try {
        const snapshot = await adminDb.collection('users').get();

        res.json({
            count: snapshot.size,
            users: snapshot.docs.map((userDoc) => {
                const data = userDoc.data();

                return {
                    uid: userDoc.id,
                    username: data.username ?? null,
                    email: data.email ?? null,
                    role: data.role ?? null,
                    accountStatus: data.accountStatus ?? null,
                };
            }),
        });
    } catch (error) {
        console.error('User diagnostics failed:', error);
        res.status(500).json({ error: 'Unable to inspect user profiles.' });
    }
});

// Create an employee account using Firebase Admin SDK.
app.post('/api/admin/users', verifyAdmin, async (req, res) => {
    let createdUid: string | undefined;

    try {
        const {
            name,
            email,
            username,
            department,
            jobTitle,
            workModePreference,
        } = req.body ?? {};

        if (
            typeof name !== 'string' ||
            !name.trim() ||
            typeof email !== 'string' ||
            !email.trim() ||
            typeof username !== 'string' ||
            !/^[a-zA-Z0-9._-]{3,30}$/.test(username.trim())
        ) {
            res.status(400).json({
                error: 'Valid name, email and username are required.',
            });
            return;
        }

        const normalizedEmail = email.trim().toLowerCase();
        const normalizedUsername = username.trim().toLowerCase();

        const usernameQuery = await adminDb
            .collection('users')
            .where('username', '==', normalizedUsername)
            .limit(1)
            .get();

        if (!usernameQuery.empty) {
            res.status(409).json({
                error: 'That username is already in use.',
            });
            return;
        }

        const temporaryPassword = randomBytes(32).toString('base64url');

        const createdUser = await adminAuth.createUser({
            email: normalizedEmail,
            displayName: name.trim(),
            password: temporaryPassword,
            disabled: false,
        });

        createdUid = createdUser.uid;

        const now = new Date().toISOString();

        await adminDb.collection('users').doc(createdUid).set({
            uid: createdUid,
            username: normalizedUsername,
            name: name.trim(),
            email: normalizedEmail,
            role: 'employee',
            department:
                typeof department === 'string' && department.trim()
                    ? department.trim()
                    : 'General',
            jobTitle:
                typeof jobTitle === 'string' ? jobTitle.trim() : '',
            workModePreference:
                ['office', 'home', 'hybrid'].includes(workModePreference)
                    ? workModePreference
                    : 'hybrid',
            accountStatus: 'active',
            createdAt: now,
            updatedAt: now,
        });

        const passwordSetupLink = await adminAuth.generatePasswordResetLink(
            normalizedEmail
        );

        res.status(201).json({
            message: 'Employee account created.',
            uid: createdUid,
            email: normalizedEmail,
            passwordSetupLink,
            note: 'Deliver this setup link through an approved email service before onboarding the employee.',
        });
    } catch (error: any) {
        if (createdUid) {
            try {
                await adminAuth.deleteUser(createdUid);
                await adminDb.collection('users').doc(createdUid).delete();
            } catch (rollbackError) {
                console.error(
                    'Account creation rollback failed:',
                    rollbackError
                );
            }
        }

        console.error('Employee provisioning failed:', error);

        if (error?.code === 'auth/email-already-exists') {
            res.status(409).json({
                error: 'An account already exists for this email.',
            });
            return;
        }

        res.status(500).json({
            error: 'Unable to create employee account.',
        });
    }
});

// Synchronize employee account activation with Firebase Authentication.
app.patch(
    '/api/admin/users/:uid/status',
    verifyAdmin,
    async (req, res) => {
        try {
            const { uid } = req.params;
            const { accountStatus } = req.body ?? {};

            if (!['active', 'inactive'].includes(accountStatus)) {
                res.status(400).json({
                    error: 'Account status must be active or inactive.',
                });
                return;
            }

            const userRef = adminDb.collection('users').doc(uid);
            const userSnapshot = await userRef.get();

            if (!userSnapshot.exists) {
                res.status(404).json({ error: 'User not found.' });
                return;
            }

            const user = userSnapshot.data();

            if (user?.role === 'admin') {
                res.status(403).json({
                    error: 'Administrator account status cannot be changed through this endpoint.',
                });
                return;
            }

            await adminAuth.updateUser(uid, {
                disabled: accountStatus === 'inactive',
            });

            await userRef.update({
                accountStatus,
                updatedAt: new Date().toISOString(),
            });

            res.json({
                message: 'Account status updated.',
                uid,
                accountStatus,
            });
        } catch (error: any) {
            console.error('Account status update failed:', error);

            if (error?.code === 'auth/user-not-found') {
                res.status(404).json({ error: 'Authentication account not found.' });
                return;
            }

            res.status(500).json({
                error: 'Unable to update account status.',
            });
        }
    }
);

app.listen(PORT, () => {
    console.log(`Teara WorkHub API listening on http://localhost:${PORT}`);
});
